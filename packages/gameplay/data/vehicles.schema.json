{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "vehicles.schema.json",
 "type": "object",
 "required": [
  "vehicles"
 ],
 "properties": {
  "vehicles": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "class",
     "size",
     "seats",
     "seatAnchors",
     "mass",
     "maxSpeed",
     "accel",
     "brake",
     "turn",
     "grip",
     "fuel",
     "stamina",
     "health",
     "storage",
     "hitches",
     "interior",
     "footprint",
     "collider"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "class": {
      "enum": [
       "bicycle",
       "car",
       "truck",
       "van",
       "camper",
       "semi",
       "trailer",
       "wagon",
       "cart",
       "carriage",
       "chariot"
      ]
     },
     "size": {
      "enum": [
       "xs",
       "s",
       "m",
       "l",
       "xl"
      ]
     },
     "seats": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
     },
     "seatAnchors": {
      "type": "array",
      "maxItems": 8,
      "description": "One anchor per seat (length = seats); seat 0 = driver.",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "x",
        "y",
        "z"
       ],
       "properties": {
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        },
        "z": {
         "type": "number"
        }
       },
       "description": "Vehicle-local offset: x along heading (+front), y left (+exit side), z up (world z units)."
      }
     },
     "mass": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "maxSpeed": {
      "type": "number",
      "minimum": 0
     },
     "accel": {
      "type": "number",
      "minimum": 0
     },
     "brake": {
      "type": "number",
      "minimum": 0
     },
     "turn": {
      "type": "number",
      "minimum": 0
     },
     "grip": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "fuel": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "required": [
         "capacity",
         "perSecond"
        ],
        "properties": {
         "capacity": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "perSecond": {
          "type": "number",
          "minimum": 0
         }
        }
       }
      ]
     },
     "stamina": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "required": [
         "perSecond"
        ],
        "properties": {
         "perSecond": {
          "type": "number",
          "minimum": 0
         }
        }
       }
      ]
     },
     "health": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "storage": {
      "type": "object",
      "required": [
       "slots",
       "maxWeight"
      ],
      "properties": {
       "slots": {
        "type": "integer",
        "minimum": 0,
        "maximum": 24
       },
       "maxWeight": {
        "type": "number",
        "minimum": 0
       }
      }
     },
     "hitches": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "at",
        "offset",
        "accepts",
        "anchor"
       ],
       "properties": {
        "at": {
         "enum": [
          "front",
          "rear"
         ]
        },
        "offset": {
         "type": "number",
         "minimum": 0
        },
        "accepts": {
         "type": "array",
         "items": {
          "enum": [
           "bicycle",
           "car",
           "truck",
           "van",
           "camper",
           "semi",
           "trailer",
           "wagon",
           "cart",
           "carriage",
           "chariot"
          ]
         }
        },
        "anchor": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "x",
          "y",
          "z"
         ],
         "properties": {
          "x": {
           "type": "number"
          },
          "y": {
           "type": "number"
          },
          "z": {
           "type": "number"
          }
         },
         "description": "Hitch point, vehicle-local; x = +offset (front) or -offset (rear)."
        }
       }
      }
     },
     "interior": {
      "type": "object",
      "required": [
       "stations"
      ],
      "properties": {
       "stations": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     },
     "footprint": {
      "type": "object",
      "required": [
       "length",
       "width"
      ],
      "properties": {
       "length": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "width": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      }
     },
     "collider": {
      "type": "object",
      "required": [
       "radius"
      ],
      "properties": {
       "radius": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      }
     },
     "covered": {
      "type": "boolean",
      "description": "ADR-358: canvas cover on a wagon (same footprint as its uncovered twin). Only class wagon may set it true."
     },
     "drawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "pullMul"
      ],
      "description": "ADR-358: animal-drawn vehicles only. pullMul multiplies the pulling mount's current gait speed (walk/gallop); the result is capped by maxSpeed.",
      "properties": {
       "pullMul": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 2
       }
      }
     }
    }
   }
  }
 }
}

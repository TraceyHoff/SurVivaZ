  "wateredMul": 1.0,
  "wateredSeconds": 600,
  "fertilizerMul": 1.5,
  "fertilizerSeconds": 600,
  "dungFertilizerSeconds": 900,
  "waterRadius": 2.0,
  "fertilizeRadius": 1.5,
  "plantReach": 2.5,
  "minSpacing": 0.9,
  "tickSeconds": 1,
